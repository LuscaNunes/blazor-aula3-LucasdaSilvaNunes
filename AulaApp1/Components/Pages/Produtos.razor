@page "/produtos"
@using AulaApp1.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="row">
    
    <div class="col-md-4">
        <Cartao Titulo="Cadastrar Novo Produto">
            <FormProduto OnProdutoAdicionado="AdicionarNoBanco" />
        </Cartao>
    </div>

    <div class="col-md-8">
        @if (listaProdutos == null)
        {
            <p>Carregando banco de dados...</p>
        }
        else if (listaProdutos.Count == 0)
        {
            <div class="alert alert-info">Nenhum produto cadastrado no banco ainda.</div>
        }
        else
        {
            <TabelaProdutos Produtos="listaProdutos" />
        }
    </div>
</div>

@code {
    private List<Produto>? listaProdutos;

    // Dispara assim que a página é acessada
    protected override async Task OnInitializedAsync()
    {
        await CarregarDoBanco();
    }

    // SELECT * FROM Produtos
    private async Task CarregarDoBanco()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        listaProdutos = await context.Produtos.ToListAsync();
    }

    // INSERT INTO Produtos
    private async Task AdicionarNoBanco(Produto produtoRecebido)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.Produtos.Add(produtoRecebido);
        
        // É este comando que escreve fisicamente no HD e salva no MySQL!
        await context.SaveChangesAsync(); 

        // Atualiza a tabela na tela
        await CarregarDoBanco();
    }
}