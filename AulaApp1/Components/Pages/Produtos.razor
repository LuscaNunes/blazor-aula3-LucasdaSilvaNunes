@page "/produtos"

<div class="row">
    
    <div class="col-md-4">
        <Cartao Titulo="Cadastrar Novo Produto">
            <FormProduto OnProdutoAdicionado="AdicionarNaLista" />
        </Cartao>
    </div>

    <div class="col-md-8">
        @if (listaProdutos.Count == 0)
        {
            <div class="alert alert-info">Nenhum produto cadastrado ainda.</div>
        }
        else
        {
            <TabelaProdutos Produtos="listaProdutos" />
        }
    </div>
</div>

@code {
    private List<Produto> listaProdutos = new();

    private void AdicionarNaLista(Produto produtoRecebido)
    {
        listaProdutos.Add(produtoRecebido);
    }
}