@page "/categoria"

<h3 class="mb-4">Categoria</h3>
<div class="row">
    <div class="col-md-4">
        <div class="card card-body">
            <label class="form-label">Nome</label>
            <input @bind="nome"/>
            <label class="form-label">Quantidade</label>
            <input type="number" @bind="quantidade"/>
            <button class="btn btn-primary" @onclick="AdicionarCategoria">Adicionar Categoria</button>
        </div>
    </div>
	
    <div class="col-md-8">
        <div class="card card-body">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">Quantidade</th>
                </tr>
                </thead>
                <tbody>
                @if (categoria.Count == 0)
                {
                    <p class="text-muted"> Nenhuma Categoria cadastrado </p>
                }
                else
                {
                    @foreach (var p in categoria)
                    {
                        <tr>
                            <td>@p.nome</td>
                            <td>@p.quantidade</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
@code {
    private string nome = "";
    private int quantidade;

    private List<Categoria> categoria = new();

    private void AdicionarCategoria()
    {
        categoria.Add(new Categoria
        {
            nome = nome,
            quantidade = quantidade
        });
        nome = "";
        quantidade = 0;
    }

}