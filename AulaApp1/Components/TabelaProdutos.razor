<table class="table table-striped">
    <thead>
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Quantidade</th>
        <th>Ações</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Produtos)
    {
        <tr>
            <td>@p.Nome</td>
            <td>@p.Preco</td>
            <td>@p.Quantidade</td>
            <td>
                <button class="btn btn-danger btn-sm" @onclick="() => OnProdutoExcluido.InvokeAsync(p)">Excluir</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    [Parameter]
    public List<Produto> Produtos { get; set; } = new();

    [Parameter]
    public EventCallback<Produto> OnProdutoExcluido { get; set; }
}